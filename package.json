{
  "name": "febran-desktop",
  "version": "1.0.3",
  "description": "Febran WA Gateway Desktop Application & Node Server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File ./scripts/build-sidecar.ps1",
    "tauri": "tauri",
    "tauri:dev": "npm run build:sidecar && tauri dev",
